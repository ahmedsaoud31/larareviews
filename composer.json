{
    "name": "ahmedsaoud31/larareviews",
    "description": "Unified Laravel package to aggregate, manage, and render reviews from TripAdvisor, Viator, GetYourGuide, Google Reviews, and custom platforms on tour and activity pages.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Saoud",
            "email": "ahmedsaoud31@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/database": "^9.0|^10.0|^11.0",
        "illuminate/view": "^9.0|^10.0|^11.0",
        "illuminate/console": "^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "LaraReviews\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraReviews\\LaraReviewsServiceProvider"
            ],
            "aliases": {
                "LaraReviews": "LaraReviews\\Facades\\LaraReviews"
            }
        }
    },
    "minimum-stability": "stable"
}